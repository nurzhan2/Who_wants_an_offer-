{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-8010",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "env": {
        "DATABASE_URL": "postgresql+asyncpg://postgres:postgres@localhost:5436/offers_walk",
        "SOURCES_DISABLED": "jsearch,hh"
      },
      "port": 8010
    },
    {
      "name": "web-5180",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "env": {
        "VITE_API_URL": "http://127.0.0.1:8010"
      },
      "port": 5180
    }
  ]
}
