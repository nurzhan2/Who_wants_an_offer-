# Local apply agent. The browser profile holds the owner's live hh session —
# cookies, tokens, history — and is the one directory in this repository that
# must never be committed by accident. The screenshots are taken on failure and
# show a logged-in account.
agent/profile/
agent/screenshots/
agent/*.sqlite3
agent/queue.json
agent/answers/
# The probe's reports and the session signal are measurements of a logged-in
# session: a report carries the owner's own application state for a vacancy and
# the top-level keys of their authenticated page. Evidence for the selectors,
# not something to publish.
agent/probe/
agent/queue-results.json
agent/session_signal.json

