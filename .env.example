# Copy to .env and fill in. Never commit .env.
# Empty value == "not configured": the feature that needs it stays off.

# ── Core ─────────────────────────────────────────────────────────────
ENVIRONMENT=development                # development | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
# Port 5436, not 5432: a local PostgreSQL install would answer on 5432 but
# has no pgvector, and 5433-5435 are often taken by other projects.
# Must match POSTGRES_PORT below.
POSTGRES_PORT=5436
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/offers
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/offers_test
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173     # comma-separated

# ── LLM ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Hot path — vacancy re-rank, Telegram post parsing. Runs thousands of times
# per day, so it must stay cheap.
ANTHROPIC_MODEL=claude-sonnet-5
# Cold path — resume extraction, cover letters. Runs rarely, quality wins.
ANTHROPIC_MODEL_HEAVY=claude-opus-5
LLM_RERANK_TOP_N=30
LLM_MAX_COST_PER_RUN_USD=2.0
# ── LLM routing ──────────────────────────────────────────────────────
# Which provider serves which task. "cli" is the Claude Code CLI (a
# subscription, no API key needed), "api" is the Anthropic API, "ollama" is a
# local server. Every task must appear; startup fails otherwise.
#
# The split is arithmetic. A CLI call carries ~50,000 tokens of Claude Code's
# own system prompt whatever the payload — measured at $0.064 for a prompt whose
# answer is {"ok": true}, and $0.21 for a real resume. That is fine once per
# upload and ruinous at re-rank's 120 calls a day (~$44/day of quota), so the
# rare tasks go to the CLI and the frequent ones do not.
# LLM_ROUTING={"resume_extraction":"cli","cover_letter":"cli","cv_tailoring":"cli","tooling":"cli","telegram_parse":"ollama","vacancy_parse":"api","rerank":"api"}
#
# Where a call goes when its provider is not there. Every fallback is logged at
# WARNING: a silent switch would put two extraction qualities in one dataset.
# LLM_FALLBACK_CHAIN={"cli":["api"],"ollama":["api"],"api":[]}
#
# How hard to think, per task. One global setting would either overspend on the
# hot path or underthink on the cold one.
# LLM_TASK_EFFORT={"resume_extraction":"high","cover_letter":"high","cv_tailoring":"high","tooling":"high","vacancy_parse":"medium","telegram_parse":"low","rerank":"low"}

# ── Claude Code CLI provider ─────────────────────────────────────────
# Resolved from PATH when unset. Set it when several installs exist.
CLAUDE_CLI_BINARY=
CLAUDE_CLI_TIMEOUT=300
# Reading a file costs a turn, so a PDF needs more than one.
CLAUDE_CLI_MAX_TURNS=6
# A local process, not a server.
CLAUDE_CLI_CONCURRENCY=2

# ── Ollama provider ──────────────────────────────────────────────────
# Main path for parsing Telegram posts. Measure before relying on it: on
# CPU-only hardware a 7B model in Q4 runs at single-digit tokens per second,
# which turns 200 posts into hours. The fallback to the API covers the gap.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=180

ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT=120
ANTHROPIC_MAX_RETRIES=4
# USD per million tokens, as JSON, keyed by model id. Defaults ship in
# app/core/config.py (Anthropic list prices as of 2026-09-03). Uncomment only to
# override them — for negotiated rates, or when the list prices change.
# LLM_PRICING={"claude-opus-5": {"input_usd_per_mtok": 5.0, "output_usd_per_mtok": 25.0}}

# ── Embeddings ───────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# "bge-m3" runs the real model and needs `uv sync --extra embeddings`
# (~1.5 GB of dependencies, plus 2.3 GB of weights on first use).
# "fake" is a deterministic stub — fine for frontend work and for tests.
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_BATCH_SIZE=16
# How much one run may embed. On a CPU-only machine bge-m3 costs roughly seven
# seconds a posting, so the two budgets between them decide how long the step
# runs: it stops at whichever it reaches first, always between batches, and
# every batch it finished is already committed. Raise them to drain a backlog
# faster; the work is never lost, only postponed to the next run.
EMBEDDING_MAX_PER_RUN=2000
EMBEDDING_TIME_BUDGET_SECONDS=3600
# Vectors are cached by sha256(model + text). Without this a full pipeline run
# re-encodes thousands of unchanged vacancies.
EMBEDDING_CACHE_DIR=.cache/embeddings

# ── HTTP ─────────────────────────────────────────────────────────────
HTTP_TIMEOUT=30
USER_AGENT=who-wants-an-offer/1.0 (+https://github.com/nurzhan2/Who_wants_an_offer-)
# Set in dev to cache source responses on disk. The comment is on its own
# line deliberately: an inline one after an EMPTY value is read as the value,
# so `HTTP_CACHE_DIR=  # comment` silently turns the cache ON, pointed at a
# directory named after the comment.
HTTP_CACHE_DIR=

# ── Resume upload ────────────────────────────────────────────────────
RESUME_MAX_FILE_SIZE_MB=10
# A profile whose parse has been pending longer than this is reported as
# failed: background tasks do not survive a restart.
RESUME_PARSE_TIMEOUT_SECONDS=900
UPLOAD_DIR=uploads

# ── ATS readability audit ────────────────────────────────────────────
# Thresholds for the check that answers "will an employer's parser read
# this resume?". They are here rather than in code because the right value
# depends on the resumes people actually upload, and the only way to learn
# it is to move one and re-run the audit over a directory of them.
#
# Two words start next to each other in the same column when their left
# edges are within this fraction of the page width. Larger merges a sidebar
# into the body; smaller reads an indented paragraph as its own column.
ATS_COLUMN_GAP_RATIO=0.06
# A band holding fewer than this share of the page's words is not a column.
# Stops a page number in a corner from reading as a sidebar.
ATS_MIN_COLUMN_SHARE=0.08
# Share of lines mixing two columns before the layout is called broken. A
# couple of crossed lines is a wide heading; a sixth of the page is columns.
ATS_MIXED_LINE_RATIO=0.15
# Fewer extractable characters than this and the file is a scan, not a
# resume — whatever it looks like to a person.
ATS_MIN_TEXT_CHARS=200
# Share of characters that are not letters, digits or punctuation before the
# font is called broken. Above it the text layer is glyphs with nothing
# behind them.
ATS_BROKEN_GLYPH_RATIO=0.05
# Share of words inside tables before the layout is flagged. A dates column
# is fine; a resume built out of tables is read cell by cell and shuffled.
ATS_TABLE_WORD_RATIO=0.30
# At or above this lightness (0-1) a character is the colour of the paper.
ATS_INVISIBLE_LUMINANCE=0.90
# Below this lightness a filled shape is a dark banner: light text on it is a
# design, not a hidden keyword block.
ATS_DARK_FILL_LUMINANCE=0.50
# Font size in points below which text is not meant for a human reader.
ATS_MIN_FONT_SIZE=4.0
# How many invisible characters make a block rather than a paste artefact.
ATS_HIDDEN_CHAR_LIMIT=20
# Word count a resume has to reach before there is anything to match.
ATS_MIN_RESUME_WORDS=100
# Word count past which an import is likely to truncate the end.
ATS_MAX_RESUME_WORDS=1200

# ── Sources: framework ───────────────────────────────────────────────
# Source-agnostic on purpose: adding a connector must not mean editing this
# file, so there is no HH_ENABLED / JSEARCH_ENABLED here and never will be.
#
# Slugs switched off for this deployment, comma-separated.
SOURCES_DISABLED=
# When non-empty, ONLY these slugs run. For a debugging session.
SOURCES_ENABLED=
# Per-source credentials as JSON, keyed "<slug>.<name>". A connector declares
# the keys it needs and reports the missing NAMES on GET /api/v1/sources —
# never a value, a prefix or a length. Leave blank when nothing is configured.
# Example with a real key in place:
#   SOURCE_CREDENTIALS={"jsearch.rapidapi_key": "your-rapidapi-key"}
SOURCE_CREDENTIALS=
# How long a cached source response stays fresh when the connector does not
# override it. Only consulted when HTTP_CACHE_DIR is set.
HTTP_CACHE_TTL_SECONDS=3600
# Ceiling on the searches one run may issue per source. Enforced by throwing
# the excess away, not by warning about it: a plan that is merely advised to
# stay small is a plan that grows.
MAX_QUERIES_PER_RUN=8
# Largest batch of external ids in one "which of these do we already hold?"
# lookup. Without a cap a long run builds a query with thousands of parameters.
EXTERNAL_ID_LOOKUP_BATCH=500

# ── Sources: optional API keys ───────────────────────────────────────
# jsearch (RapidAPI -> Google for Jobs). Core source: this is how LinkedIn and
# Indeed postings reach the system legally.
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
THEMUSE_API_KEY=
FINDWORK_TOKEN=

# ── Telegram source (Telethon user session) ──────────────────────────
# Core source for KZ/RU. Requires a *user* session, not a bot: a bot cannot
# read arbitrary public channels. Use a separate phone number, not your main
# account — Telegram restricts accounts that trip flood limits.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# e.g. ./telegram.session (gitignored). Comment on its own line — see
# HTTP_CACHE_DIR above for why.
TELEGRAM_SESSION_PATH=

# ── Notifications (Telegram bot) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MATCH_SCORE_ALERT_THRESHOLD=80
QUIET_HOURS=23:00-08:00

# ── Pipeline ─────────────────────────────────────────────────────────
FULL_RUN_INTERVAL_HOURS=12
INCREMENTAL_RUN_INTERVAL_HOURS=3
MAX_VACANCY_AGE_DAYS=45

# ── Local apply agent (agent/) ───────────────────────────────────────
# The agent runs on your own machine, in your own browser, under your own hh
# account, and reaches the backend only over HTTP — it has no database access.
# This token is the whole of the authentication between the two, on purpose:
# both processes are yours and on the same host, so there is no second party to
# authenticate. What it buys is that nothing else on the host can read your
# letter queue by guessing a URL.
#
# The agent and `python -m wwao` read it from this same file (the environment
# wins when both are set). `python -m wwao up` fills an empty one for you.
# To generate one by hand:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset means the queue endpoints refuse to serve at all. Do not expose this
# API beyond localhost; a bigger token is not the fix for that.
AGENT_API_TOKEN=
# Which connector's postings the agent can act on.
AGENT_SOURCE_SLUG=hh
# Match score a vacancy needs before it is offered to the agent. 78 is the
# floor of "strong" on the default title formula; with
# `run_matching.py --formula components` the matching floor is 70.
AGENT_QUEUE_MIN_SCORE=78
# Hours a confirmation given on the dashboard's vacancy card stays valid. An
# older one is ignored by the agent and the dashboard asks for it again.
AGENT_CONFIRMATION_TTL_HOURS=72

# ── Frontend (Vite) ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
